# Copy to `.env` and fill in. `.env` is gitignored.

# Importer log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# mymind API endpoint. Override only if you point at a staging cluster.
MYMIND_API_BASE=https://api.mymind.com

# HS256 signing key for the mymind API (see https://access.mymind.com/api).
# Required for `tomymind push <source>` and (later) the mymind-importer service.
# Treat MYMIND_API_KEY_SECRET like a password -- it grants full read/write on
# your mymind account.
MYMIND_API_KEY_ID=
MYMIND_API_KEY_SECRET=
