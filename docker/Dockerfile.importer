# syntax=docker/dockerfile:1.7
#
# Image for the mymind-importer service. Installs only the `importer` extra
# so the scraper-side deps (Playwright + Chromium, ~1 GB) stay out.
#
# We install dependencies only (`--no-install-project`) and expose the
# package via PYTHONPATH instead of letting uv build the project wheel.
# Reason: `pyproject.toml` declares both `src/tomymind` and
# `src/mymind_importer` under `tool.hatch.build.targets.wheel.packages`, and
# `.dockerignore` keeps `src/tomymind` out of this image — a wheel build
# would error on the missing package directory.

FROM python:3.12-slim-bookworm AS base

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --extra importer

COPY src/mymind_importer ./src/mymind_importer

RUN groupadd -r app && useradd -r -g app -s /sbin/nologin app
USER app

ENV PYTHONPATH=/app/src \
    PATH="/app/.venv/bin:$PATH"

ENTRYPOINT ["python", "-m", "mymind_importer"]
